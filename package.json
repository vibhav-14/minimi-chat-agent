{
  "name": "minimi-chat-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A chat agent with one tool, web search, and a dated memory of every conversation.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "try:search": "tsx --env-file-if-exists=.env scripts/try-search.ts"
  },
  "dependencies": {
    "@google/genai": "^3.1.0",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
