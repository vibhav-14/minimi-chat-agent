# Copy this file to .env and fill in the two keys. Both services have a free tier.

# Required. Gemini API key, free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required. Tavily search API key, free tier: https://app.tavily.com
TAVILY_API_KEY=

# Optional. Tavily search depth: advanced (2 credits per query, page passages
# most relevant to the query) or basic (1 credit, shorter passages).
# Default: advanced
TAVILY_SEARCH_DEPTH=

# Optional. Port for the web UI and API. Default: 3000
PORT=

# Optional. Gemini model ID. Default: gemini-3.8-flash
GEMINI_MODEL=

# Optional. Directory for the conversation database. Default: ./data
DATA_DIR=

# Optional. IANA time zone used to read dates like "last Tuesday",
# for example Asia/Kolkata. Default: this machine's time zone
USER_TIMEZONE=
